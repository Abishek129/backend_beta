# backend_beta environment — copy to .env and fill in.

# --- LoggerFast HTTP API (import source) -------------------------------------
LOGGER_API_URL=http://127.0.0.1:8003
LOGGER_API_USER=
LOGGER_API_PASSWORD=
LOGGER_API_TIMEOUT=20

# --- LoggerFast timeseries DB (the tables the sockets read) ------------------
LOGGER_TIMESERIES_DSN=postgresql://postgres@127.0.0.1:5433/target_version1?options=-csearch_path%3Dneuract

# --- Metadata DB (defaults: cmd_equipment_beta as postgres@localhost:5432) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Django ------------------------------------------------------------------
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=

# --- AI summary service (off by default in beta) -----------------------------
AI_SUMMARY_ENABLED=0
