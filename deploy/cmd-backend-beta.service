[Unit]
Description=EMS backend (Django + Channels, Daphne :18889)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/rohithdev/EMSbackend
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/home/rohithdev/EMSbackend/.venv/bin/daphne -b 0.0.0.0 -p 18889 config.asgi:application
Restart=always
RestartSec=3
# Django loads /home/rohithdev/EMSbackend/.env itself (see config/settings.py).
# Keep logs in the journal, not an unbounded file.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=emsbackend

[Install]
WantedBy=default.target
